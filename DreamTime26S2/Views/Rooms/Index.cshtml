@model IEnumerable<DreamTime26S2.Models.Room>

@{
    ViewData["Title"] = "Manage rooms";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add room</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Code)
            </td>
            <td>
                @Html.DisplayFor(model => item.RoomType.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-code="@item.Code" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil-fill"></i>
                    Edit
                </a>
                <a asp-action="Delete" asp-route-code="@item.Code" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash-fill"></i>
                    Delete
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
