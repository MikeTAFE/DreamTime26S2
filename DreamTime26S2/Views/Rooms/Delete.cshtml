@model DreamTime26S2.Models.Room

@{
    ViewData["Title"] = "Delete room";
}

<h1>@ViewData["Title"]</h1>

<hr />

<p>Are you sure you want to delete the &ldquo;<strong>@Html.DisplayFor(g => g.Code)</strong>&rdquo; room?</p>

<div>
    <form asp-action="Delete">
        <span asp-validation-for="Code" class="text-danger d-block mb-2"></span>
        <input type="hidden" asp-for="Code" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
