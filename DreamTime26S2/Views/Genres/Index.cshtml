@model IEnumerable<DreamTime26S2.Models.Genre>

@{
    ViewData["Title"] = "Manage genres";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus me-1" aria-hidden="true"></i>
        Add genre
    </a>
</p>

<div class="row">
    <div class="col-lg-6">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.Name)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-pencil-fill me-1" aria-hidden="true"></i>
                            Edit
                        </a>
                        @* <a asp-action="Details" asp-route-id="@item.Id">Details</a> | *@
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash-fill me-1" aria-hidden="true"></i>
                                Delete
                            </a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>