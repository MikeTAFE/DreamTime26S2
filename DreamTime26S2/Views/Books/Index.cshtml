@model IEnumerable<DreamTime26S2.Models.Book>

@{
    ViewData["Title"] = "Manage books";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add book</a>
</p>

<table class="table manage-books-table">
    <caption>List of books to manage</caption>
    <thead>
        <tr>
            <th>
                Image
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISBN)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DatePublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Copies)
            </th>
            <th aria-label="Actions: edit, details, delete"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* @Html.DisplayFor(modelItem => item.ImageFilename) *@
                    @* Load the book image thumbnail or default image (if unavailable) *@
                    <partial name="_BookImagePartial" model="item" />
                </td>
                <td class="text-nowrap">
                    @Html.DisplayFor(modelItem => item.ISBNFormatted)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Author)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DatePublished)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Copies)
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-isbn="@item.ISBN" class="btn btn-sm btn-outline-primary" aria-label="Edit" title="Edit">
                        <i class="bi bi-pencil-fill"></i>
                    </a>
                    <a asp-action="Details" asp-route-isbn="@item.ISBN" class="btn btn-sm btn-outline-secondary" aria-label="Details" title="Details">
                        <i class="bi bi-book-half"></i>
                    </a>
                    <a asp-action="Delete" asp-route-isbn="@item.ISBN" class="btn btn-sm btn-outline-danger" aria-label="Delete" title="Delete">
                        <i class="bi bi-trash-fill"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
