@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    bool isMember = User.IsInRole("Member");
    bool isStaff = User.IsInRole("Staff");
    bool isManager = User.IsInRole("Manager");
    bool isLoggedIn = SignInManager.IsSignedIn(User);
}

<ul class="navbar-nav flex-grow-1">

    @* Common links for ALL users *@
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="" asp-controller="Books" asp-action="ViewAll">All books</a>
    </li>

    @* TODO: Add create reservation links *@

    @* Custom nav for anonymous users (not logged in) *@
    @if (!isLoggedIn)
    {
        // E.g. register & login
    }

    @* Custom nav for member/user/customer *@
    @if (isMember)
    {
        <partial name="Nav/_MemberNavPartial" />
    }

    @* Custom nav for ALL staff *@
    @if (isStaff)
    {
        <partial name="Nav/_StaffNavPartial" />
    }

    @* Custom nav for regular staff (not managers) *@
    @if (isStaff && !isManager)
    {
        // Staff who are not managers
    }

    @* Custom nav for managers *@
    @if (isManager)
    {
        <partial name="Nav/_ManagerNavPartial" />
    }

</ul>