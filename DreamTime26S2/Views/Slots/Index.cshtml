@model IEnumerable<DreamTime26S2.Models.Slot>

@{
    ViewData["Title"] = "Manage slots";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add slot</a>
</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>
                    Weekday
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Date)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SlotType)
                </th>
                <th>
                    Slot Time
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Available)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Date.DayOfWeek
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SlotType.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StartTime)
                        -
                        @Html.DisplayFor(modelItem => item.EndTime)
                    </td>
                    <td class="status-@(item.Available ? "available" : "unavailable")">
                        @* @Html.DisplayFor(modelItem => item.Available) *@
                        @(item.Available ? "Yes" : "No")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-pencil-fill"></i>
                            Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">
                            <i class="bi bi-book-half"></i>
                            Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash-fill"></i>
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>