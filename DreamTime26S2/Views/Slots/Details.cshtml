@model DreamTime26S2.Models.Slot

@{
    ViewData["Title"] = "Slot details";
}

<h1>@ViewData["Title"]</h1>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3 col-md-2 col-xl-1">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class="col-sm-9 col-md-10 col-xl-11">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class="col-sm-3 col-md-2 col-xl-1">
            @Html.DisplayNameFor(model => model.Available)
        </dt>
        <dd class="col-sm-9 col-md-10 col-xl-11">
            @Html.DisplayFor(model => model.Available)
        </dd>
        <dt class="col-sm-3 col-md-2 col-xl-1">
            @Html.DisplayNameFor(model => model.SlotType)
        </dt>
        <dd class="col-sm-9 col-md-10 col-xl-11">
            @Html.DisplayFor(model => model.SlotType.Name)
        </dd>
        <dt class="col-sm-3 col-md-2 col-xl-1">
            @Html.DisplayNameFor(model => model.StartTimeslot)
        </dt>
        <dd class="col-sm-9 col-md-10 col-xl-11">
            @Html.DisplayFor(model => model.StartTime)
        </dd>
        <dt class="col-sm-3 col-md-2 col-xl-1">
            @Html.DisplayNameFor(model => model.EndTimeslot)
        </dt>
        <dd class="col-sm-9 col-md-10 col-xl-11">
            @Html.DisplayFor(model => model.EndTime)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>