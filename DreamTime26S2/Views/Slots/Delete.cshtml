@model DreamTime26S2.Models.Slot

@{
    ViewData["Title"] = "Delete slot";
}

<h1>@ViewData["Title"]</h1>

<p>Are you sure you want to delete the &ldquo;<strong>@Html.DisplayFor(s => s.Date) - @Html.DisplayFor(s => s.SlotType.Name)</strong>&rdquo; session?</p>

<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
