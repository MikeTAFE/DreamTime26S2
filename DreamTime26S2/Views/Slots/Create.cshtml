@model DreamTime26S2.Models.Slot

@{
    ViewData["Title"] = "Create slot";
}

<h1>@ViewData["Title"]</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" class="d-flex flex-column gap-2">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="form-group col-6">
                    <label asp-for="Date" class="control-label"></label>
                    <input asp-for="Date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="SlotTypeId" class="control-label"></label>
                    <select asp-for="SlotTypeId" class="form-control" asp-items="ViewBag.SlotTypeList"></select>
                    <span asp-validation-for="SlotTypeId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="form-group col-6">
                    <label asp-for="StartTime" class="control-label"></label>
                    <select asp-for="StartTime" class="form-control" asp-items="ViewBag.StartTimeList"></select>
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="form-group col-6">
                    <label asp-for="EndTime" class="control-label"></label>
                    <select asp-for="EndTime" class="form-control" asp-items="ViewBag.EndTimeList"></select>
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Available" /> @Html.DisplayNameFor(model => model.Available)
                </label>
                <span asp-validation-for="Available" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
