@model IEnumerable<DreamTime26S2.Models.Reservation>

@{
    ViewData["Title"] = "Manage reservations";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add reservation</a>
</p>

<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                #
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Slot)
            </th>
            <th>
                Reservation Time
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomType)
            </th>
            <th>
                # People
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Slot.Date)
                -
                @Html.DisplayFor(modelItem => item.Slot.SlotType.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartTime)
                -
                @Html.DisplayFor(modelItem => item.EndTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomType.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumberOfPeople)
            </td>
            <td class="status-td status-@item.Status.ToString().ToLower()">
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td class="text-nowrap">
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            @* <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Id)
            </td> *@
            <td class="d-flex gap-1">
                <a asp-action="Edit" asp-route-id="@item.Id"
                    class="btn btn-sm btn-secondary" title="Edit">
                    <i class="bi bi-pencil-fill" aria-label="Edit"></i>
                </a>
                <a asp-action="Details" asp-route-id="@item.Id"
                    class="btn btn-sm btn-primary" title="Details">
                    <i class="bi bi-book-half" aria-label="Details"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@item.Id"
                    class="btn btn-sm btn-danger" title="Delete">
                    <i class="bi bi-trash-fill" aria-label="Delete"></i>
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
